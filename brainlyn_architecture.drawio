              <mxPoint x="750" y="170" />
              <mxPoint x="1140" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e2b" value="2b. Parallel Live Sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#673ab7;" edge="1" parent="1" source="search_endpoint" target="ecourts_gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2b_api" value="HTTP GET (2.5s Timeout)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#673ab7;" edge="1" parent="1" source="ecourts_gateway" target="external_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="3. Raw 39-Field Cases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#673ab7;" edge="1" parent="1" source="ecourts_gateway" target="similarity_engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e4" value="4. Filtered (Score 75% to 100%)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#673ab7;" edge="1" parent="1" source="similarity_engine" target="dedup_block">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5_bg" value="5. Enqueue New Cases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#e91e63;" edge="1" parent="1" source="dedup_block" target="bg_worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
