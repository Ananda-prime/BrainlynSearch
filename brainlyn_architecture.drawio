        <mxCell id="e5_es" value="Async Index Doc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#e91e63;" edge="1" parent="1" source="bg_worker" target="es_indices">
